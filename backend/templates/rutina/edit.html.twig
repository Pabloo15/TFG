{% extends 'base.html.twig' %}

{% block title %}Editar Rutina - GymTrack{% endblock %}

{% block body %}
<style>
    /* BASE E IDENTIDAD VISUAL (Consistente) */
    body { background-color: #0f0f0f; color: #e0e0e0; font-family: 'Segoe UI', sans-serif; }
    .gym-navbar { background-color: #000; border-bottom: 1px solid #222; padding: 0.8rem 1.5rem; display: flex; justify-content: space-between; align-items: center; }
    .gym-logo { font-weight: 800; text-transform: uppercase; color: #fff; text-decoration: none; }
    .gym-logo span { color: #ff0000; }
    .main-container { max-width: 900px; margin: 30px auto; padding: 0 20px; }

    /* CABECERA */
    .page-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px; padding-bottom: 15px; border-bottom: 2px solid #1a1a1a; }
    .page-title h1 { font-size: 1.8rem; font-weight: 800; margin: 0; text-transform: uppercase; }

    /* FORMULARIO ESTILIZADO */
    .form-section { background: #111; border: 1px solid #222; border-radius: 12px; padding: 25px; margin-bottom: 25px; }
    .form-label { color: #ff0000; font-weight: 700; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 1px; }
    .gym-input { background: #0a0a0a; border: 1px solid #333; color: #fff; border-radius: 6px; padding: 12px; width: 100%; transition: 0.3s; }
    .gym-input:focus { border-color: #ff0000; outline: none; box-shadow: 0 0 10px rgba(255,0,0,0.1); }

    /* CREADOR DE EJERCICIOS */
    .exercise-builder { background: #151515; padding: 20px; border-radius: 10px; border: 1px dashed #333; margin-top: 15px; }
    .builder-row { display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 10px; }

    /* LISTA DINÁMICA */
    .exercise-list { margin-top: 20px; }
    .exercise-item { 
        background: #0a0a0a; border: 1px solid #222; padding: 12px 20px; border-radius: 8px; 
        margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center;
        border-left: 4px solid #ff0000;
    }
    .exercise-info { font-weight: 600; }
    .exercise-meta { color: #666; font-size: 0.9rem; margin-left: 10px; }

    /* BOTONES */
    .btn-gym-red { background: #ff0000; color: #fff; border: none; padding: 10px 25px; border-radius: 6px; font-weight: 700; text-transform: uppercase; cursor: pointer; transition: 0.3s; }
    .btn-gym-red:hover { background: #cc0000; transform: translateY(-2px); }
    .btn-gym-outline { background: transparent; color: #fff; border: 1px solid #333; padding: 10px 25px; border-radius: 6px; font-weight: 700; text-decoration: none; transition: 0.2s; }
    .btn-gym-outline:hover { border-color: #ff0000; color: #ff0000; }
    .btn-delete { color: #ff0000; background: none; border: none; cursor: pointer; font-size: 1.2rem; }
</style>

<nav class="gym-navbar">
    <a href="{{ path('app_rutina_index') }}" class="gym-logo">GYM<span>TRACK</span></a>
    <div style="font-size: 0.8rem; font-weight: 600;">
        <a href="{{ path('app_rutina_index') }}" style="color: #666; text-decoration: none;">VOLVER AL LISTADO</a>
    </div>
</nav>

<div class="main-container">
    <div class="page-header">
        <div class="page-title">
            <h1>Editar <span class="text-danger">Plan</span></h1>
            <p>Modificando: {{ rutina.nombre }}</p>
        </div>
    </div>

    <form method="post" id="rutina-form">
        <!-- Nombre de la Rutina -->
        <div class="form-section">
            <label class="form-label">Nombre de la Rutina</label>
            <input type="text" name="nombre" value="{{ rutina.nombre }}" class="gym-input mt-2" required placeholder="Ej: Empuje - Hipertrofia">
        </div>

        <!-- Constructor de Ejercicios -->
        <div class="form-section">
            <label class="form-label">Planificación de Ejercicios</label>
            
            <div class="exercise-builder mt-3">
                <div class="builder-row">
                    <input type="text" id="ex-name" class="gym-input" placeholder="Nombre del ejercicio">
                    <input type="number" id="ex-series" class="gym-input" placeholder="Series">
                    <input type="number" id="ex-reps" class="gym-input" placeholder="Reps">
                    <button type="button" onclick="addExercise()" class="btn-gym-red">+</button>
                </div>
            </div>

            <!-- Lista de ejercicios añadidos -->
            <div id="exercise-list-container" class="exercise-list">
                <!-- Se rellena con JS -->
            </div>

            <!-- Campo oculto donde guardaremos el texto final para la DB -->
            <input type="hidden" name="ejercicios" id="final-ejercicios-value">
        </div>

        <div class="d-flex gap-3">
            <button type="submit" class="btn-gym-red">Actualizar Rutina</button>
            <a href="{{ path('app_rutina_index') }}" class="btn-gym-outline">Cancelar</a>
        </div>
    </form>
</div>

<script>
    // Recuperamos los ejercicios actuales de la base de datos
    // Asumimos que están separados por saltos de línea
    let exercises = `{{ rutina.ejercicios|raw }}`.split('\n').filter(line => line.trim() !== "");
    
    const listContainer = document.getElementById('exercise-list-container');
    const finalInput = document.getElementById('final-ejercicios-value');

    // Función para renderizar la lista
    function renderExercises() {
        listContainer.innerHTML = '';
        exercises.forEach((ex, index) => {
            const div = document.createElement('div');
            div.className = 'exercise-item';
            div.innerHTML = `
                <div>
                    <span class="exercise-info">${ex}</span>
                </div>
                <button type="button" onclick="removeExercise(${index})" class="btn-delete">×</button>
            `;
            listContainer.appendChild(div);
        });
        // Actualizamos el input oculto que se envía al servidor
        finalInput.value = exercises.join('\n');
    }

    // Función para añadir ejercicio
    function addExercise() {
        const name = document.getElementById('ex-name').value;
        const series = document.getElementById('ex-series').value;
        const reps = document.getElementById('ex-reps').value;

        if(name && series && reps) {
            const exerciseString = `${name} - ${series} series x ${reps} reps`;
            exercises.push(exerciseString);
            
            // Limpiar campos
            document.getElementById('ex-name').value = '';
            document.getElementById('ex-series').value = '';
            document.getElementById('ex-reps').value = '';
            
            renderExercises();
        } else {
            alert("Por favor, rellena todos los campos del ejercicio");
        }
    }

    // Función para eliminar
    function removeExercise(index) {
        exercises.splice(index, 1);
        renderExercises();
    }

    // Render inicial
    renderExercises();
</script>
{% endblock %}