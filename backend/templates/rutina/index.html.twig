{% extends 'base.html.twig' %}

{% block title %}Mis Rutinas - GymTrack{% endblock %}

{% block body %}
<style>
    .rutina-container {
        padding: 40px; 
        max-width: 1200px; 
        margin: 0 auto; 
        background-color: #0a0a0a; 
        color: #fff; 
        font-family: 'Inter', sans-serif;
    }

    .rutina-grid {
        display: grid; 
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); 
        gap: 30px;
    }

    .rutina-card {
        background: rgba(20, 20, 20, 0.6); 
        border: 1px solid #222; 
        border-radius: 12px; 
        padding: 25px; 
        box-shadow: 0 4px 15px rgba(0,0,0,0.3); 
        display: flex; 
        flex-direction: column; 
        justify-content: space-between; 
        position: relative;
        transition: all 0.3s ease;
    }
    .rutina-card:hover {
        border-color: #ff0000;
        box-shadow: 0 0 15px rgba(255, 0, 0, 0.15);
    }

    .ejercicios-content {
        color: #ddd; 
        font-size: 1rem; 
        line-height: 1.6; 
        margin-bottom: 20px; 
        white-space: pre-line; 
        background: rgba(0,0,0,0.4); 
        padding: 15px; 
        border-radius: 8px; 
        border-left: 3px solid #ff0000;
    }
</style>

<div class="rutina-container">
    
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #ff0000; padding-bottom: 15px; margin-bottom: 30px;">
        <div>
            <h1 style="font-family: 'Orbitron', sans-serif; font-size: 2.2rem; font-weight: 900; text-transform: uppercase; margin: 0; letter-spacing: 1px;">
                ZONA DE ENTRENAMIENTO // <span style="color: #ff0000;">MIS RUTINAS</span>
            </h1>
            <p style="color: #666; margin: 5px 0 0 0; text-transform: uppercase; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.5px;">
                Optimiza tus entrenamientos con planes personalizados
            </p>
        </div>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_rutina_new') }}" style="background: #ff0000; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 6px; font-weight: 800; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; box-shadow: 0 0 15px rgba(255, 0, 0, 0.4); transition: all 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 0 25px rgba(255,0,0,0.7)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 0 15px rgba(255, 0, 0, 0.4)';">
                + Nueva Rutina
            </a>
        {% endif %}
    </div>

    <div class="rutina-grid">
        {% if rutinas is not empty %}
            {% for rutina in rutinas %}
                <div class="rutina-card">
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                            <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; border: 1px solid #ff0000; color: #ff0000; letter-spacing: 0.5px;">
                                GYMTRACK PRO
                            </span>
                        </div>

                        <h3 style="font-family: 'Orbitron', sans-serif; font-size: 1.5rem; font-weight: 900; margin: 0 0 15px 0; color: #fff; text-transform: uppercase;">
                            {{ rutina.nombre }}
                        </h3>

                        <h4 style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; color: #666; margin: 0 0 10px 0; letter-spacing: 0.5px;">
                            Ejercicios Asignados:
                        </h4>
                        
                        <div class="ejercicios-content">
                            {{ rutina.ejercicios|nl2br }}
                            
                        </div>
                    </div>

                    <div>
                        <div style="border-top: 1px solid #222; padding-top: 15px; display: flex; justify-content: flex-end; align-items: center;">
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_rutina_edit', {'id': rutina.id}) }}" style="color: #ffffff; background: rgba(255,255,255,0.05); border: 1px solid #333; text-decoration: none; padding: 6px 14px; border-radius: 4px; font-size: 0.8rem; text-transform: uppercase; font-weight: 700; transition: all 0.2s;" onmouseover="this.style.borderColor='#ff0000'; this.style.color='#ff0000';" onmouseout="this.style.borderColor='#333'; this.style.color='#fff';">
                                    Editar
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div style="grid-column: 1 / -1; text-align: center; padding: 60px; color: #444; border: 2px dashed #222; border-radius: 12px; font-weight: 600; text-transform: uppercase; font-size: 0.9rem;">
                <p style="margin-bottom: 20px;">Todavía no has creado ninguna rutina de entrenamiento.</p>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_rutina_new') }}" style="color: #ff0000; font-weight: 700; text-decoration: none; letter-spacing: 0.5px;">Comenzar ahora →</a>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}