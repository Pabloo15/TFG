{% extends 'base.html.twig' %}

{% block title %}Mis Rutinas - GymTrack{% endblock %}

{% block body %}
<style>
    body { background-color: #000; color: #fff; font-family: sans-serif; }
    
    .page-header { border-left: 5px solid #ff0000; padding-left: 20px; margin-bottom: 40px; }
    .page-title { font-size: 2.5rem; font-weight: 900; text-transform: uppercase; margin: 0; }

    .btn-create-gym { 
        background-color: #ff0000; 
        color: #000; 
        font-weight: 900; 
        padding: 10px 20px; 
        border-radius: 8px; 
        text-decoration: none; 
        text-transform: uppercase;
        font-size: 0.9rem;
    }

    .rutina-card {
        background-color: #111;
        border: 1px solid #333;
        border-left: 8px solid #ff0000;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 30px;
    }
    
    .rutina-header { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        margin-bottom: 15px; 
    }
    
    .rutina-nombre { color: #fff; font-size: 1.6rem; font-weight: 900; text-transform: uppercase; margin: 0; }

    /* CONTENEDOR ALINEADO A LA IZQUIERDA */
    .ejercicios-container {
        background-color: #0a0a0a;
        padding: 20px;
        border-radius: 10px;
        color: #ddd;
        font-family: sans-serif;
        line-height: 1.6;
        white-space: pre-line; /* Mantiene los saltos de línea sin espacios raros */
        text-align: left;      /* Alineación total a la izquierda */
        border: 1px solid #222;
    }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div class="page-header">
            <h1 class="page-title">MIS <span class="text-danger">RUTINAS</span></h1>
        </div>
        <a href="{{ path('app_rutina_new') }}" class="btn-create-gym">+ Crear Nueva</a>
    </div>

    <div class="row">
        {% for rutina in rutinas %}
            <div class="col-12">
                <div class="rutina-card shadow">
                    <div class="rutina-header">
                        <h2 class="rutina-nombre">{{ rutina.nombre }}</h2>
                        <span class="badge bg-danger text-black fw-bold" style="font-size: 0.6rem;">GYMTRACK PRO</span>
                    </div>
                    <hr class="border-secondary mb-3">
                    <div class="ejercicios-container">
                        {{ rutina.ejercicios|trim }}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <p class="text-secondary">No hay rutinas guardadas.</p>
                <a href="{{ path('app_rutina_new') }}" class="text-danger fw-bold text-decoration-none">Crear mi primera rutina</a>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
