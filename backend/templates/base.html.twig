<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}GymTrack{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        
        <style>
            /* FUENTE Y RESET */
            @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Inter:wght@400;600;800&display=swap');
            
            body {
                background-color: #0a0a0a;
                margin: 0;
                font-family: 'Inter', sans-serif;
                -webkit-font-smoothing: antialiased;
            }

            /* MENÚ SUPERIOR PREMIUM */
            .gym-header-nav {
                background: linear-gradient(180deg, #111111 0%, #070707 100%);
                border-bottom: 2px solid #ff0000;
                padding: 18px 40px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                box-shadow: 0 4px 20px rgba(255, 0, 0, 0.05);
            }

            /* BLOQUE IZQUIERDO: BRANDING Y SOCIO */
            .nav-left-zone {
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

            .user-badge {
                font-size: 0.75rem;
                text-transform: uppercase;
                color: #ff4444;
                font-weight: 800;
                letter-spacing: 2px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            /* Texto del usuario estático y limpio */
            .user-name-text {
                color: #ffffff;
                font-size: 1.2rem; 
                font-weight: 900;
                letter-spacing: 0.5px;
            }

            .gym-main-title {
                font-family: 'Orbitron', sans-serif;
                font-size: 2.4rem;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: -1px;
                color: #ffffff;
                margin: 0;
                line-height: 1.1;
            }
            .gym-main-title span { 
                color: #ff0000; 
                text-shadow: 0 0 12px rgba(255, 0, 0, 0.4);
            }

            /* BLOQUE CENTRAL: NAVEGACIÓN COMPACTA */
            .nav-center-links {
                display: flex;
                gap: 40px;
            }
            .nav-link-item {
                color: #aaaaaa;
                text-decoration: none;
                font-weight: 700;
                text-transform: uppercase;
                font-size: 0.95rem;
                letter-spacing: 1.5px;
                transition: all 0.3s ease;
                padding: 6px 0;
                position: relative;
            }
            .nav-link-item::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 0;
                height: 2px;
                background-color: #ff0000;
                transition: width 0.3s ease;
            }
            .nav-link-item:hover { 
                color: #ffffff; 
            }
            .nav-link-item:hover::after {
                width: 100%;
            }

            /* BLOQUE DERECHO: BOTÓN SALIR EQUILIBRADO */
            .nav-right-zone {
                display: flex;
                align-items: center;
            }
            .btn-logout-header {
                background: transparent;
                color: #ffffff;
                border: 2px solid #333333;
                padding: 10px 24px;
                border-radius: 6px; 
                font-weight: 700;
                text-transform: uppercase;
                font-size: 0.8rem;
                letter-spacing: 1px;
                text-decoration: none;
                transition: all 0.2s ease-in-out;
            }
            .btn-logout-header:hover {
                background: #ff0000;
                border-color: #ff0000;
                color: #ffffff;
                box-shadow: 0 0 15px rgba(255, 0, 0, 0.4);
                transform: translateY(-1px);
            }
        </style>
        
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body>

        <nav class="gym-header-nav">
            <div class="nav-left-zone">
                <div class="user-badge">
                    ⚡ SOCIO // 
                    <span class="user-name-text">
                        {{ app.user.nombre|default('MIGUE')|upper }}
                    </span>
                </div>
                <h1 class="gym-main-title">GYM<span>TRACK</span></h1>
            </div>

            <div class="nav-center-links">
                <a href="{{ path('app_clase_index') }}" class="nav-link-item">Clases</a>
                <a href="{{ path('app_rutina_index') }}" class="nav-link-item">Rutinas</a>
            </div>

            <div class="nav-right-zone">
                <a href="{{ path('app_logout') }}" class="btn-logout-header">Salir</a>
            </div>
        </nav>

        <main>
            {% block body %}{% endblock %}
        </main>

    </body>
</html>