<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}GymTrack - Entrenamiento Pro{% endblock %}</title>
        <link href="https://jsdelivr.net" rel="stylesheet">
        <style>
            body { background-color: #000; color: #fff; font-family: sans-serif; margin: 0; }
            .navbar-gym { background-color: #0a0a0a !important; border-bottom: 2px solid #ff0000; padding: 0.5rem 0; }
            .brand-gym { color: #fff; font-weight: 900; font-size: 1.5rem; text-decoration: none !important; }
            .brand-track { color: #ff0000 !important; font-weight: 900; font-size: 1.5rem; text-decoration: none !important; }
            .nav-link { color: #fff !important; font-weight: bold; text-transform: uppercase; font-size: 0.8rem; padding: 0 10px !important; text-decoration: none !important; }
            .btn-logout { border: 1px solid #ff0000; color: #ff0000 !important; font-weight: 700; border-radius: 30px; padding: 3px 12px; text-decoration: none !important; font-size: 0.7rem; }
            .user-label { color: #ff0000; font-weight: 900; text-transform: uppercase; font-size: 0.9rem; line-height: 1; }
        </style>
    </head>
    <body>
        {# EL MENÚ: No aparece en el Login para que no se desconfigure #}
        {% if app.user and app.request.attributes.get('_route') != 'app_login' %}
            <nav class="navbar navbar-expand navbar-dark navbar-gym mb-4">
                <div class="container d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div style="border-right: 1px solid #333; padding-right: 15px; margin-right: 15px; display: flex; flex-direction: column;">
                            <span style="color: #666; font-size: 0.5rem; text-transform: uppercase;">Socio</span>
                            <span class="user-label">{{ app.user.Nombre|default('MIGUE') }}</span>
                        </div>
                        <a class="brand-gym" href="{{ path('app_clase_index') }}">GYM<span class="brand-track">TRACK</span></a>
                        <div class="d-flex ms-3">
                            <a class="nav-link" href="{{ path('app_clase_index') }}">Clases</a>
                            <a class="nav-link" href="{{ path('app_rutina_index') }}">Rutinas</a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a class="nav-link" href="{{ path('app_usuario_index') }}">Usuarios</a>
                            {% endif %}
                        </div>
                    </div>
                    <a class="btn-logout" href="{{ path('app_logout') }}">SALIR</a>
                </div>
            </nav>
        {% endif %}

        {# LOGO PARA EL LOGIN: Centrado arriba #}
        {% if app.request.attributes.get('_route') == 'app_login' %}
            <div class="text-center mt-5" style="z-index: 10;">
                <h1 class="brand-gym" style="font-size: 3.5rem; letter-spacing: 3px;">GYM<span class="brand-track">TRACK</span></h1>
            </div>
        {% endif %}

        <div class="container">
            {% block body %}{% endblock %}
        </div>
        <script src="https://jsdelivr.net"></script>
    </body>
</html>
