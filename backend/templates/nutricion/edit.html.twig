{% extends 'base.html.twig' %}

{% block title %}Editar Receta - GymTrack{% endblock %}

{% block body %}
<div style="max-width: 600px; margin: 40px auto; padding: 30px; background: #111; border: 1px solid #222; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.5); font-family: 'Inter', sans-serif; color: #fff;">
    
    <h2 style="font-family: 'Orbitron', sans-serif; color: #ffffff; font-size: 1.6rem; text-transform: uppercase; margin-top: 0; margin-bottom: 25px; border-bottom: 2px solid #ff0000; padding-bottom: 10px; letter-spacing: 1px;">
        Modificar // <span style="color: #ff0000;">Editar Receta</span>
    </h2>

    {{ form_start(form) }}
        <div class="gym-form-container" style="display: flex; flex-direction: column; gap: 15px;">
            {{ form_widget(form) }}
        </div>

        <div style="margin-top: 30px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #222; padding-bottom: 20px;">
            <div style="display: flex; gap: 15px; align-items: center;">
                <button style="background: #ff0000; color: #fff; border: none; padding: 12px 24px; border-radius: 4px; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; cursor: pointer; box-shadow: 0 0 10px rgba(255,0,0,0.3);">
                    Actualizar Receta
                </button>
                <a href="{{ path('app_recetas') }}" style="color: #aaa; text-decoration: none; font-size: 0.9rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Volver al listado</a>
            </div>
    {{ form_end(form) }}

            {# BOTÓN DE ELIMINAR COMPLETAMENTE SEGURO CON CSRF TOKEN #}
            <form method="post" action="{{ path('app_receta_delete', {'id': receta.id}) }}" onsubmit="return confirm('¿Seguro que quieres borrar esta receta de la base de datos?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ receta.id) }}">
                <button style="background: transparent; color: #ff3333; border: 1px solid #ff3333; padding: 10px 18px; border-radius: 4px; font-weight: 700; text-transform: uppercase; font-size: 0.8rem; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='#ff3333'; this.style.color='#fff';" onmouseout="this.style.background='transparent'; this.style.color='#ff3333';">
                    Eliminar
                </button>
            </form>
        </div>
</div>

<style>
    /* Mantenemos tus inputs oscuros premium */
    .gym-form-container input, .gym-form-container textarea, .gym-form-container select {
        width: 100%;
        padding: 12px;
        background: #000;
        border: 1px solid #444;
        border-radius: 10px;
        color: #fff;
        font-family: 'Inter', sans-serif;
        box-sizing: border-box;
    }
    .gym-form-container input:focus, .gym-form-container textarea:focus, .gym-form-container select:focus {
        border-color: #ff0000;
        outline: none;
    }
    .gym-form-container label {
        display: block;
        font-size: 0.8rem;
        text-transform: uppercase;
        color: #ffffff;
        font-weight: 700;
        margin-bottom: 5px;
        letter-spacing: 1px;
    }
</style>
{% endblock %}