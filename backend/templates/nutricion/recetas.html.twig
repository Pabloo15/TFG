{% extends 'base.html.twig' %}

{% block title %}Nutrición - GymTrack{% endblock %}

{% block body %}
<div style="padding: 40px; max-width: 1200px; margin: 0 auto; background-color: #0a0a0a; color: #fff; font-family: 'Inter', sans-serif;">
    
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #ff0000; padding-bottom: 15px; margin-bottom: 30px;">
        <div>
            <h1 style="font-family: 'Orbitron', sans-serif; font-size: 2.2rem; font-weight: 900; text-transform: uppercase; margin: 0; letter-spacing: 1px;">
                COMBUSTIBLE PREMIUM // <span style="color: #ff0000;">RECETAS SALUDABLES</span>
            </h1>
            <p style="color: #666; margin: 5px 0 0 0; text-transform: uppercase; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.5px;">
                Optimiza tus resultados con la alimentación correcta
            </p>
        </div>

        {# BOTÓN DE AÑADIR RECETA: Solo visible para el Administrador #}
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_receta_new') }}" style="background: #ff0000; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 6px; font-weight: 800; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; box-shadow: 0 0 15px rgba(255, 0, 0, 0.4); transition: all 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 0 25px rgba(255,0,0,0.7)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 0 15px rgba(255, 0, 0, 0.4)';">
                + Añadir Receta
            </a>
        {% endif %}
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 30px;">
        
        {# RECORREMOS LAS RECETAS DE LA BASE DE DATOS #}
        {% for receta in recetas %}
            <div style="background: rgba(20, 20, 20, 0.6); border: 1px solid #222; border-radius: 12px; padding: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); display: flex; flex-direction: column; justify-content: space-between; position: relative;">
                
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; border: 1px solid 
                            {% if receta.categoria == 'Definición' %}#3498db; color: #3498db;
                            {% elseif receta.categoria == 'Volumen' %}#e74c3c; color: #e74c3c;
                            {% else %}#2ecc71; color: #2ecc71;{% endif %}">
                            {{ receta.categoria }}
                        </span>
                        <span style="font-size: 0.8rem; color: #aaa; font-weight: 600;">
                            ⏱️ {{ receta.tiempo }} min
                        </span>
                    </div>

                    <h3 style="font-size: 1.4rem; font-weight: 800; margin: 0 0 12px 0; color: #fff;">{{ receta.titulo }}</h3>
                    <p style="color: #999; font-size: 0.9rem; line-height: 1.4; margin-bottom: 20px;">{{ receta.descripcion }}</p>

                    <h4 style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; color: #ff4444; margin: 0 0 8px 0; letter-spacing: 0.5px;">
                        Ingredientes Clave:
                    </h4>
                    <div style="color: #ddd; font-size: 0.9rem; line-height: 1.5; margin-bottom: 20px; white-space: pre-line;">
                        {{ receta.ingredientes }}
                    </div>
                </div>

                <div>
                    <div style="border-top: 1px solid #222; padding-top: 15px; font-size: 0.9rem; color: #aaa; font-weight: 600; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span style="color: #2ecc71; font-weight: 800;">Proteínas:</span> {{ receta.proteinas }}g | 
                            <span style="color: #fff; font-weight: 800;">Kcal:</span> {{ receta.kcal }}
                        </div>
                        
                        {# Botones de edición para el Admin en cada tarjeta #}
                        {% if is_granted('ROLE_ADMIN') %}
                            <div style="display: flex; gap: 10px;">
                                <a href="{{ path('app_receta_edit', {'id': receta.id}) }}" style="color: #3498db; text-decoration: none; font-size: 0.8rem; text-transform: uppercase; font-weight: 700;">Editar</a>
                            </div>
                        {% endif %}
                    </div>
                </div>

            </div>
        {% else %}
            <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: #666; font-weight: 600; text-transform: uppercase; font-size: 0.9rem;">
                No hay recetas registradas. ¡Pulsa "+ Añadir Receta" para estrenar la sección!
            </div>
        {% endfor %}

    </div>
</div>
{% endblock %}