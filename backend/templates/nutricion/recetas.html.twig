{% extends 'base.html.twig' %}

{% block title %}Recetas Saludables - GymTrack{% endblock %}

{% block body %}
<div style="max-width: 1200px; margin: 40px auto; padding: 0 20px; font-family: 'Inter', sans-serif; color: #fff;">
    
    <div style="margin-bottom: 40px; border-bottom: 2px solid #ff0000; padding-bottom: 15px;">
        <h2 style="font-family: 'Orbitron', sans-serif; color: #ffffff; font-size: 2rem; text-transform: uppercase; margin: 0; letter-spacing: 1px;">
            Combustible Premium // <span style="color: #ff0000;">Recetas Saludables</span>
        </h2>
        <p style="color: #666; margin: 5px 0 0 0; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px;">
            Optimiza tus resultados con la alimentación correcta
        </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
        
        <div style="background: #111; border: 1px solid #222; border-radius: 8px; padding: 25px; box-shadow: 0 4px 20px rgba(0,0,0,0.3); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <span style="background: rgba(255, 0, 0, 0.1); color: #ff4444; border: 1px solid #ff0000; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">Hipertrofia / Volumen</span>
                    <span style="color: #666; font-size: 0.85rem; font-weight: 700;">🕒 20 min</span>
                </div>
                <h3 style="font-family: 'Orbitron', sans-serif; margin: 0 0 10px 0; font-size: 1.3rem; color: #fff;">Pollo al Curry con Arroz Integral</h3>
                <p style="color: #aaa; font-size: 0.9rem; line-height: 1.5; margin-bottom: 20px;">Una comida clásica de culturismo con un toque delicioso de especias para aportar carbohidratos complejos y proteína limpia.</p>
                
                <h4 style="color: #ff4444; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 5px; letter-spacing: 1px;">Ingredientes clave:</h4>
                <p style="color: #eee; font-size: 0.85rem; margin: 0 0 20px 0; line-height: 1.4;">• 200g Pechuga de pollo<br>• 100g Arroz integral en seco<br>• Crema de coco ligera y curry<br>• Verduras variadas (pimiento y cebolla)</p>
            </div>
            <div style="border-top: 1px solid #222; padding-top: 15px; display: flex; justify-content: space-between; align-items: center;">
                <div style="color: #fff; font-size: 0.85rem;"><strong style="color: #00ff00;">Proteínas:</strong> 45g | <strong>Kcal:</strong> 650</div>
            </div>
        </div>

        <div style="background: #111; border: 1px solid #222; border-radius: 8px; padding: 25px; box-shadow: 0 4px 20px rgba(0,0,0,0.3); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <span style="background: rgba(0, 150, 255, 0.1); color: #33a3ff; border: 1px solid #0088ff; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">Definición / Keto</span>
                    <span style="color: #666; font-size: 0.85rem; font-weight: 700;">🕒 15 min</span>
                </div>
                <h3 style="font-family: 'Orbitron', sans-serif; margin: 0 0 10px 0; font-size: 1.3rem; color: #fff;">Salmón al Horno con Aguacate</h3>
                <p style="color: #aaa; font-size: 0.9rem; line-height: 1.5; margin-bottom: 20px;">Cargado de ácidos grasos esenciales Omega-3 y grasas saludables que protegen tu entorno hormonal durante etapas de déficit.</p>
                
                <h4 style="color: #33a3ff; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 5px; letter-spacing: 1px;">Ingredientes clave:</h4>
                <p style="color: #eee; font-size: 0.85rem; margin: 0 0 20px 0; line-height: 1.4;">• 180g Filete de salmón fresco<br>• 1/2 Aguacate mediano<br>• Espárragos trigueros al grill<br>• Chorrito de limón y eneldo</p>
            </div>
            <div style="border-top: 1px solid #222; padding-top: 15px; display: flex; justify-content: space-between; align-items: center;">
                <div style="color: #fff; font-size: 0.85rem;"><strong style="color: #00ff00;">Proteínas:</strong> 38g | <strong>Kcal:</strong> 480</div>
            </div>
        </div>

        <div style="background: #111; border: 1px solid #222; border-radius: 8px; padding: 25px; box-shadow: 0 4px 20px rgba(0,0,0,0.3); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <span style="background: rgba(0, 255, 0, 0.1); color: #22ff22; border: 1px solid #00cc00; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">Pre-Entreno / Snack</span>
                    <span style="color: #666; font-size: 0.85rem; font-weight: 700;">🕒 5 min</span>
                </div>
                <h3 style="font-family: 'Orbitron', sans-serif; margin: 0 0 10px 0; font-size: 1.3rem; color: #fff;">Gachas de Avena Energéticas</h3>
                <p style="color: #aaa; font-size: 0.9rem; line-height: 1.5; margin-bottom: 20px;">La mejor fuente de energía de asimilación lenta para rendir al máximo en tus entrenamientos intensos de pierna o fuerza.</p>
                
                <h4 style="color: #22ff22; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 5px; letter-spacing: 1px;">Ingredientes clave:</h4>
                <p style="color: #eee; font-size: 0.85rem; margin: 0 0 20px 0; line-height: 1.4;">• 60g Copos de avena fina<br>• 1 Cacito de proteína en polvo (WHEY)<br>• 1/2 Plátano en rodajas<br>• Una cucharadita de crema de cacahuete</p>
            </div>
            <div style="border-top: 1px solid #222; padding-top: 15px; display: flex; justify-content: space-between; align-items: center;">
                <div style="color: #fff; font-size: 0.85rem;"><strong style="color: #00ff00;">Proteínas:</strong> 32g | <strong>Kcal:</strong> 410</div>
            </div>
        </div>

    </div>
</div>
{% endblock %}