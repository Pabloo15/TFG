{% extends 'base.html.twig' %}

{% block title %}Registro - GymTrack{% endblock %}

{% block body %}
<style>
    body, html {
        height: 100%;
        margin: 0;
        background-color: #000000;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Arial Black', Gadget, sans-serif;
    }

    .register-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    .brand-name {
        font-size: 2.5rem;
        font-weight: 900;
        text-align: center;
        margin-bottom: 20px;
        text-transform: uppercase;
    }

    .card-gym {
        background-color: #1a1a1b;
        border: 2px solid #ff0000;
        border-radius: 25px;
        width: 350px; 
        padding: 30px;
    }

    .card-title {
        color: #ffffff;
        font-size: 1.4rem;
        font-weight: bold;
        margin-bottom: 25px;
        text-align: center;
    }

    /* Contenedor de cada campo */
    form div {
        margin-bottom: 15px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    form label {
        color: #666;
        font-size: 0.75rem;
        margin-bottom: 5px;
        text-align: center;
        width: 100%;
        display: block;
    }

    form input {
        background-color: #252526 !important;
        border: 1px solid #444 !important;
        border-radius: 10px !important;
        color: #fff !important;
        font-size: 0.9rem;
        padding: 8px;
        height: 40px;
        width: 280px; /* Tamaño fijo para asegurar que se vean */
        text-align: center;
    }

    .btn-gym {
        background-color: #ff0000 !important;
        color: #000 !important;
        border: none;
        border-radius: 10px;
        font-weight: 900;
        text-transform: uppercase;
        width: 100%;
        padding: 12px;
        margin-top: 10px;
        cursor: pointer;
    }

    .footer-links {
        text-align: center;
        margin-top: 20px;
        font-size: 0.75rem;
    }
</style>

<div class="register-wrapper">
    <div class="brand-name">
        <span style="color: #ffffff;">GYM</span><span style="color: #ff0000;">TRACK</span>
    </div>

    <div class="card card-gym shadow-lg">
        <h2 class="card-title">Nuevo Miembro</h2>
        
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-gym">
                CREAR CUENTA
            </button>
        {{ form_end(form) }}

        <div class="footer-links">
            <a href="{{ path('app_login') }}" style="color: #666; text-decoration: none;">
                ¿Ya eres socio? <span style="color: #ff0000; text-decoration: underline;">Inicia sesión</span>
            </a>
        </div>
    </div>
</div>
{% endblock %}
