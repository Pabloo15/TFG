{% extends 'base.html.twig' %}

{% block title %}Panel de Actividades - GymTrack{% endblock %}

{% block body %}
<style>
    body { background-color: #000; color: #fff; font-family: 'Arial Black', sans-serif; }
    
    .section-title { font-size: 2rem; font-weight: 900; text-transform: uppercase; border-left: 6px solid #ff0000; padding-left: 15px; }

    /* PANEL DE CALENDARIO DINÁMICO */
    .schedule-header {
        background-color: #111;
        border: 1px solid #333;
        border-bottom: 4px solid #ff0000;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 40px;
    }
    .calendar-day { 
        display: inline-block; width: 40px; height: 40px; line-height: 40px; 
        text-align: center; border-radius: 50%; border: 1px solid #444; 
        font-size: 0.9rem; margin: 5px; color: #888; transition: 0.3s;
    }
    /* Clase que se activará por JavaScript */
    .calendar-day.active { 
        background-color: #ff0000; 
        color: #000; 
        border: none; 
        font-weight: bold; 
        box-shadow: 0 0 15px rgba(255, 0, 0, 0.5);
    }

    /* TARJETAS DE ACTIVIDADES */
    .class-card {
        background-color: #111;
        border: 1px solid #333;
        border-radius: 15px;
        margin-bottom: 20px;
        transition: 0.3s;
    }
    .class-card:hover { border-color: #ff0000; }
    .class-info-box { padding: 25px; }
    .class-name { color: #ff0000; font-size: 1.8rem; font-weight: 900; text-transform: uppercase; margin-bottom: 5px; }

    /* BOTÓN DE RESERVA */
    .btn-gym {
        background-color: #ff0000; color: #000 !important; border: none; font-weight: 900;
        padding: 15px; border-radius: 10px; text-transform: uppercase; width: 100%;
        transition: 0.3s; cursor: pointer; text-decoration: none; display: block; text-align: center;
    }
    .btn-gym:hover { background-color: #fff; color: #ff0000 !important; }
    .btn-gym:disabled { background-color: #444; color: #888 !important; cursor: not-allowed; }
</style>

<div class="container mt-4">
    
    {# 1. CALENDARIO QUE MARCA EL DÍA ACTUAL #}
    <div class="schedule-header shadow-lg text-center">
        <h3 id="current-date" class="h6 text-uppercase fw-bold mb-3 text-danger" style="letter-spacing: 2px;">
            CARGANDO FECHA...
        </h3>
        <div class="d-flex justify-content-center flex-wrap" id="week-calendar">
            <div class="calendar-day" data-day="1">L</div>
            <div class="calendar-day" data-day="2">M</div>
            <div class="calendar-day" data-day="3">X</div>
            <div class="calendar-day" data-day="4">J</div>
            <div class="calendar-day" data-day="5">V</div>
            <div class="calendar-day" data-day="6">S</div>
            <div class="calendar-day" data-day="0">D</div>
        </div>
    </div>

    {# 2. TÍTULO Y BOTÓN DE AÑADIR #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="section-title">Nuestras <span class="text-white">Sesiones</span></h1>
        <a href="{{ path('app_clase_new') }}" class="btn btn-outline-danger btn-sm fw-bold px-4">+ NUEVA ACTIVIDAD</a>
    </div>

    {# 3. LISTADO DE CLASES #}
    <div class="row">
        {% for clase in clases %}
            <div class="col-12">
                <div class="class-card shadow-lg">
                    <div class="class-info-box">
                        <div class="row align-items-center">
                            <div class="col-lg-7">
                                <h2 class="class-name">{{ clase.nombre }}</h2>
                                <p class="text-secondary mb-0">{{ clase.descripcion }}</p>
                                <div class="mt-3">
                                    <span class="badge bg-dark border border-secondary p-2 me-2">🕒 {{ clase.horario ? clase.horario|date('H:i') : '10:00' }}h</span>
                                    <span class="badge bg-dark border border-secondary p-2">👤 {{ clase.aforoMaximo }} plazas máx.</span>
                                </div>
                            </div>
                            <div class="col-lg-5 mt-4 mt-lg-0">
                                <form action="{{ path('app_clase_reservar', {'id': clase.id}) }}" method="post">
                                    <button type="submit" class="btn-gym" {% if clase.aforoMaximo <= 0 %}disabled{% endif %}>
                                        {% if clase.aforoMaximo > 0 %}
                                            RESERVAR MI PLAZA
                                        {% else %}
                                            CLASE COMPLETA
                                        {% endif %}
                                    </button>
                                </form>
                                <div class="text-center mt-2">
                                    <a href="{{ path('app_clase_edit', {'id': clase.id}) }}" class="text-muted small text-decoration-none">Editar detalles</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5 border border-secondary border-dashed rounded-4">
                <p class="text-muted">No hay sesiones programadas todavía.</p>
            </div>
        {% endfor %}
    </div>
</div>

{# SCRIPT PARA HACER EL CALENDARIO REAL #}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const now = new Date();
        const days = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
        const months = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
        
        // Mostrar la fecha real
        const dateText = `${days[now.getDay()]}, ${now.getDate()} de ${months[now.getMonth()]}`;
        document.getElementById('current-date').innerText = dateText;

        // Marcar el día de la semana automáticamente
        const currentDayNumber = now.getDay(); 
        const allDays = document.querySelectorAll('.calendar-day');
        
        allDays.forEach(day => {
            if (day.getAttribute('data-day') == currentDayNumber) {
                day.classList.add('active');
            }
        });
    });
</script>
{% endblock %}
