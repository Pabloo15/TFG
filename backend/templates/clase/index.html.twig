{% extends 'base.html.twig' %}

{% block title %}Clase index{% endblock %}

{% block body %}
    <h1>Clase index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Descripcion</th>
                <th>Horario</th>
                <th>AforoMaximo</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for clase in clases %}
            <tr>
                <td>{{ clase.id }}</td>
                <td>{{ clase.nombre }}</td>
                <td>{{ clase.descripcion }}</td>
                <td>{{ clase.horario ? clase.horario|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ clase.aforoMaximo }}</td>
                <td>
                    <a href="{{ path('app_clase_show', {'id': clase.id}) }}">show</a>
                    <a href="{{ path('app_clase_edit', {'id': clase.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_clase_new') }}">Create new</a>
{% endblock %}
