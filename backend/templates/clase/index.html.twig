{% extends 'base.html.twig' %}

{% block title %}Panel de Actividades - GymTrack{% endblock %}

{% block body %}
<style>
    body { background-color: #000; color: #fff; font-family: 'Arial Black', sans-serif; }
    
    .section-title { font-size: 2rem; font-weight: 900; text-transform: uppercase; border-left: 6px solid #ff0000; padding-left: 15px; }

    /* PANEL DE HORARIO (ARRIBA) */
    .schedule-header {
        background-color: #111;
        border: 1px solid #333;
        border-bottom: 4px solid #ff0000;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 40px;
    }
    .calendar-day { 
        display: inline-block; width: 40px; height: 40px; line-height: 40px; 
        text-align: center; border-radius: 50%; border: 1px solid #444; 
        font-size: 0.9rem; margin: 5px; color: #888;
    }
    .calendar-day.active { background-color: #ff0000; color: #000; border: none; font-weight: bold; }

    /* TARJETAS DE ACTIVIDADES */
    .class-card {
        background-color: #111;
        border: 1px solid #333;
        border-radius: 15px;
        margin-bottom: 20px;
        transition: 0.3s;
    }
    .class-card:hover { border-color: #ff0000; }
    
    .class-info-box { padding: 25px; }
    .class-name { color: #ff0000; font-size: 1.8rem; font-weight: 900; text-transform: uppercase; margin-bottom: 5px; }

    .btn-gym {
        background-color: #ff0000; color: #000; border: none; font-weight: 900;
        padding: 15px; border-radius: 10px; text-transform: uppercase; width: 100%;
        transition: 0.3s;
    }
    .btn-gym:hover { background-color: #fff; color: #ff0000; }
</style>

<div class="container mt-4">
    
    {# 1. HORARIO SEMANAL ARRIBA #}
    <div class="schedule-header shadow-lg text-center">
        <h3 class="h6 text-uppercase fw-bold mb-3 text-secondary" style="letter-spacing: 2px;">Planificación Semanal</h3>
        <div class="d-flex justify-content-center flex-wrap">
            <div class="calendar-day">L</div>
            <div class="calendar-day">M</div>
            <div class="calendar-day">X</div>
            <div class="calendar-day active shadow">J</div>
            <div class="calendar-day">V</div>
            <div class="calendar-day">S</div>
            <div class="calendar-day">D</div>
        </div>
    </div>

    {# 2. TÍTULO Y BOTÓN DE AÑADIR #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="section-title">Nuestras <span class="text-white">Sesiones</span></h1>
        <a href="{{ path('app_clase_new') }}" class="btn btn-outline-danger btn-sm fw-bold px-4">+ NUEVA ACTIVIDAD</a>
    </div>

    {# 3. LISTADO DE CLASES #}
    <div class="row">
        {% for clase in clases %}
            <div class="col-12">
                <div class="class-card shadow-lg">
                    <div class="class-info-box">
                        <div class="row align-items-center">
                            <div class="col-lg-7">
                                <h2 class="class-name">{{ clase.nombre }}</h2>
                                <p class="text-secondary mb-0">{{ clase.descripcion|default('Sesión de alto rendimiento en GymTrack.') }}</p>
                                <div class="mt-3">
                                    <span class="badge bg-dark border border-secondary p-2 me-2">🕒 {{ clase.horario ? clase.horario|date('H:i') : '10:00' }}h</span>
                                    <span class="badge bg-dark border border-secondary p-2">👤 {{ clase.aforoMaximo }} plazas máx.</span>
                                </div>
                            </div>
                            <div class="col-lg-5 mt-4 mt-lg-0">
                                <button class="btn btn-gym">RESERVAR MI PLAZA</button>
                                <div class="text-center mt-2">
                                    <a href="{{ path('app_clase_edit', {'id': clase.id}) }}" class="text-muted small text-decoration-none">Editar detalles</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5 border border-secondary border-dashed rounded-4">
                <p class="text-muted">No hay sesiones programadas todavía.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
