{% extends 'base.html.twig' %}

{% block title %}Sesiones - GymTrack{% endblock %}

{% block body %}
<style>
    /* RESET Y BASE */
    body { 
        background-color: #0f0f0f; 
        color: #e0e0e0; 
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    /* BARRA DE NAVEGACIÓN COMPACTA */
    .gym-navbar {
        background-color: #000;
        border-bottom: 1px solid #222;
        padding: 0.8rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .gym-logo { font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: #fff; text-decoration: none; }
    .gym-logo span { color: #ff0000; }

    /* CONTENEDOR PRINCIPAL REESTRUCTURADO */
    .main-container { max-width: 1100px; margin: 30px auto; padding: 0 20px; }

    /* CABECERA DE PÁGINA */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 30px;
        padding-bottom: 15px;
        border-bottom: 2px solid #1a1a1a;
    }
    .page-title h1 { font-size: 1.8rem; font-weight: 800; margin: 0; text-transform: uppercase; }
    .page-title p { color: #666; margin: 0; font-size: 0.9rem; }

    /* CALENDARIO SEMANAL (MÁS FINO) */
    .calendar-strip {
        display: flex;
        gap: 10px;
        margin-bottom: 40px;
    }
    .day-pill {
        flex: 1;
        background: #151515;
        border: 1px solid #222;
        padding: 10px;
        text-align: center;
        border-radius: 8px;
        transition: 0.2s;
    }
    .day-pill .name { display: block; font-size: 0.7rem; color: #555; text-transform: uppercase; font-weight: bold; }
    .day-pill .num { font-size: 1.1rem; font-weight: 700; }
    .day-pill.active { border-color: #ff0000; background: #1a0000; color: #ff0000; }

    /* FILA DE ACTIVIDAD (ESTILO LISTA PROFESIONAL) */
    .activity-row {
        background: #111;
        border: 1px solid #222;
        border-radius: 10px;
        margin-bottom: 12px;
        display: grid;
        grid-template-columns: 100px 1fr 200px 180px;
        align-items: center;
        padding: 15px 25px;
        transition: transform 0.2s, border-color 0.2s;
    }
    .activity-row:hover { border-color: #444; background: #151515; }

    .activity-time { font-size: 1.2rem; font-weight: 800; color: #fff; }
    
    .activity-main h2 { font-size: 1.3rem; font-weight: 700; margin: 0; color: #ff0000; }
    .activity-main p { font-size: 0.9rem; color: #888; margin: 2px 0 0; }

    .activity-status { font-size: 0.85rem; color: #aaa; text-align: center; }
    .status-badge { 
        display: inline-block; padding: 4px 12px; border-radius: 20px; 
        background: #000; border: 1px solid #333; font-weight: 600; 
    }

    /* BOTONES */
    .btn-reserve {
        background: #ff0000;
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.8rem;
        cursor: pointer;
        width: 100%;
    }
    .btn-reserve:hover { background: #cc0000; }
    .btn-reserve:disabled { background: #222; color: #555; cursor: not-allowed; }

    .btn-add {
        background: #fff;
        color: #000;
        padding: 8px 20px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.8rem;
    }

    /* RESPONSIVE */
    @media (max-width: 850px) {
        .activity-row {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 15px;
        }
    }
</style>

<nav class="gym-navbar">
    <a href="#" class="gym-logo">GYM<span>TRACK</span></a>
    <div style="font-size: 0.8rem; font-weight: 600;">
        <span style="color: #666">CONECTADO COMO:</span> {{ app.user.nombre|default('ADMIN') }}
        <a href="{{ path('app_logout') }}" style="color: #ff0000; margin-left: 15px; text-decoration: none;">SALIR</a>
    </div>
</nav>

<div class="main-container">
    
    <!-- CALENDARIO SEMANAL -->
    <div class="calendar-strip" id="calendar">
        <!-- Generado por JS para ser real -->
    </div>

    <!-- CABECERA -->
    <div class="page-header">
        <div class="page-title">
            <h1 id="today-name">Sesiones de Hoy</h1>
            <p id="today-full-date">Jueves, 14 de Mayo</p>
        </div>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_clase_new') }}" class="btn-add">NUEVA SESIÓN</a>
        {% endif %}
    </div>

    <!-- LISTADO EN FORMATO FILA -->
    <div class="activity-list">
        {% for clase in clases %}
            <div class="activity-row">
                <div class="activity-time">
                    {{ clase.horario ? clase.horario|date('H:i') : '00:00' }}
                </div>
                
                <div class="activity-main">
                    <h2>{{ clase.nombre }}</h2>
                    <p>{{ clase.descripcion }}</p>
                </div>

                <div class="activity-status">
                    <span class="status-badge">
                        {{ clase.aforoMaximo }} plazas libres
                    </span>
                    {% if is_granted('ROLE_ADMIN') %}
                        <div style="margin-top: 8px;">
                            <a href="{{ path('app_clase_edit', {'id': clase.id}) }}" style="color: #555; text-decoration: none; font-size: 0.75rem;">Editar clase</a>
                        </div>
                    {% endif %}
                </div>

                <div class="activity-action">
                    <form action="{{ path('app_clase_reservar', {'id': clase.id}) }}" method="post">
                        <button type="submit" class="btn-reserve" {% if clase.aforoMaximo <= 0 %}disabled{% endif %}>
                            {% if clase.aforoMaximo > 0 %} Reservar {% else %} Completo {% endif %}
                        </button>
                    </form>
                </div>
            </div>
        {% else %}
            <div style="text-align: center; padding: 50px; color: #444; border: 2px dashed #222; border-radius: 10px;">
                No hay actividades programadas.
            </div>
        {% endfor %}
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const calendarEl = document.getElementById('calendar');
        const now = new Date();
        const daysShort = ['DOM', 'LUN', 'MAR', 'MIE', 'JUE', 'VIE', 'SAB'];
        const daysLong = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
        const months = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];

        // Títulos de hoy
        document.getElementById('today-name').innerText = `Sesiones de ${daysLong[now.getDay()]}`;
        document.getElementById('today-full-date').innerText = `${daysLong[now.getDay()]}, ${now.getDate()} de ${months[now.getMonth()]}`;

        // Generar 7 días
        for(let i = -3; i <= 3; i++) {
            const d = new Date();
            d.setDate(now.getDate() + i);
            
            const pill = document.createElement('div');
            pill.className = `day-pill ${i === 0 ? 'active' : ''}`;
            pill.innerHTML = `
                <span class="name">${daysShort[d.getDay()]}</span>
                <span class="num">${d.getDate()}</span>
            `;
            calendarEl.appendChild(pill);
        }
    });
</script>
{% endblock %}