{% extends 'base.html.twig' %}

{% block title %}Acceso - GymTrack{% endblock %}

{% block body %}
<style>
    body { 
        background: linear-gradient(rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.75)), 
                    url('{{ asset('images/gym-bg.png') }}');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        display: flex; 
        flex-direction: column;
        align-items: center; 
        justify-content: center; 
        min-height: 80vh; 
        margin: 0;
    }
    
    .login-card { 
        background-color: rgba(26, 26, 27, 0.9); 
        border: 2px solid #ff0000; 
        border-radius: 25px; 
        width: 100%;
        max-width: 400px; 
        padding: 40px; 
        box-shadow: 0 10px 40px rgba(255, 0, 0, 0.25);
        backdrop-filter: blur(8px);
        margin-top: 20px;
    }
    
    .form-label-gym { color: #fff; font-weight: bold; text-transform: uppercase; font-size: 0.75rem; margin-bottom: 8px; display: block; }
    .form-control-gym { background-color: #000 !important; border: 1px solid #444 !important; color: #fff !important; border-radius: 10px !important; padding: 12px !important; margin-bottom: 20px; }
    .form-control-gym:focus { border-color: #ff0000 !important; box-shadow: none !important; }
    .btn-gym-red { background-color: #ff0000; color: #000; font-weight: 900; border: none; border-radius: 10px; width: 100%; padding: 15px; text-transform: uppercase; transition: 0.3s; }
    .btn-gym-red:hover { background-color: #fff; transform: translateY(-2px); }

    .register-link-container { margin-top: 40px; text-align: center; }
    .text-register { color: #ffffff !important; font-size: 0.9rem; text-decoration: none; }
    .text-register b { color: #ff0000; }
</style>

<div class="login-card">
    <form method="post">
        <h2 class="text-center text-white fw-bold mb-4" style="letter-spacing: 2px;">INICIO <span class="text-danger">SESIÓN</span></h2>

        {% if error %}
            <div class="alert alert-danger p-2 small text-center mb-3">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <div>
            <label class="form-label-gym">Email o Usuario</label>
            {# IMPORTANTE: name="email" #}
            <input type="text" value="{{ last_username }}" name="email" class="form-control-gym" required autofocus placeholder="Admin / Email">
        </div>
        
        <div>
            <label class="form-label-gym">Contraseña</label>
            {# IMPORTANTE: name="password" #}
            <input type="password" name="password" class="form-control-gym" required placeholder="********">
        </div>

        {# Token CSRF con ID 'authenticate' #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="btn-gym-red shadow" type="submit">Entrar al Centro</button>
        
        <div class="register-link-container">
            <a href="{{ path('app_usuario_new') }}" class="text-register">
                ¿No tienes cuenta? <b>Únete ahora</b>
            </a>
        </div>
    </form>
</div>
{% endblock %}