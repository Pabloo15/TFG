{% extends 'base.html.twig' %}

{% block title %}Iniciar Sesión - GymTrack{% endblock %}

{% block body %}
<style>
    body, html {
        height: 100%;
        margin: 0;
        background-color: #000000;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Arial Black', Gadget, sans-serif;
    }

    .brand-name {
        font-size: 2.5rem;
        font-weight: 900;
        text-align: center;
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: -1px;
    }

    .card-gym {
        background-color: #1a1a1b; /* Gris muy oscuro */
        border: 2px solid #ff0000; /* Borde rojo fino */
        border-radius: 25px; /* Bordes muy redondeados como en tu imagen */
        width: 320px; /* Más estrecho */
        padding: 20px;
    }

    .card-title {
        color: #ffffff;
        font-size: 1.4rem;
        font-weight: bold;
        margin-bottom: 20px;
    }

    /* Cuadros de texto más pequeños y oscuros */
    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
    }

    .form-group label {
        color: #666;
        font-size: 0.8rem;
        width: 80px;
    }

    .form-control {
        background-color: #252526 !important;
        border: 1px solid #444 !important;
        border-radius: 10px !important;
        color: #fff !important;
        font-size: 0.8rem;
        padding: 5px 10px;
        height: 35px; /* Altura reducida */
    }

    /* Botón rojo sólido y rectangular */
    .btn-gym {
        background-color: #ff0000 !important;
        color: #000 !important;
        border: none;
        border-radius: 8px;
        font-weight: 900;
        text-transform: uppercase;
        width: 100%;
        padding: 10px;
        margin-top: 10px;
    }

    .footer-links {
        text-align: center;
        margin-top: 15px;
        font-size: 0.75rem;
    }
</style>

<div class="login-wrapper">
    <div class="brand-name">
        <span style="color: #ffffff;">GYM</span><span style="color: #ff0000;">TRACK</span>
    </div>

    <div class="card card-gym shadow-lg">
        <h2 class="card-title">Acceso de Usuario</h2>
        
        <form method="post">
            {% if error %}
                <div class="alert alert-danger p-1 small" style="font-size: 0.7rem;">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <div class="form-group">
                <label>Email</label>
                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" placeholder="correo@gymtrack.com" required autofocus>
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <input type="password" name="password" id="inputPassword" class="form-control" placeholder="••••••••" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn btn-gym" type="submit">
                ENTRAR AL CENTRO
            </button>

            <div class="footer-links">
                <a href="{{ path('app_usuario_new') }}" style="color: #666; text-decoration: none;">
                    ¿No tienes cuenta? <span style="color: #ff0000; text-decoration: underline;">Únete ahora</span>
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
